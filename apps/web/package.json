{
  "name": "@proyekkas/web",
  "version": "0.23.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "gen:openapi": "node scripts/gen-openapi.mjs",
    "check:openapi": "node scripts/gen-openapi.mjs --check",
    "gen:privacy-notice": "node scripts/gen-privacy-notice.mjs",
    "check:privacy-notice": "node scripts/gen-privacy-notice.mjs --check",
    "gen:import-template": "node scripts/gen-import-template.mjs",
    "check:import-template": "node scripts/gen-import-template.mjs --check",
    "build": "npm run gen:openapi && next build --webpack && npm run build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest run -c vitest.integration.config.ts",
    "test:kc": "vitest run -c vitest.kc.config.ts",
    "payload": "payload",
    "migrate": "payload migrate",
    "seed": "payload run src/seed/index.ts",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/email-nodemailer": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/translations": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "@react-pdf/renderer": "4.9.0",
    "graphql": "16.14.2",
    "jose": "6.2.12",
    "motion": "13.4.0",
    "next": "16.4.2",
    "openid-client": "6.8.8",
    "payload": "3.90.1",
    "pg": "8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fflate": "0.8.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
