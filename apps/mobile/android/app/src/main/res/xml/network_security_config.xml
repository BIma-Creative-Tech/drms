<?xml version="1.0" encoding="utf-8"?>
<!-- ADR 0010 decision 9: TLS only, system trust anchors only, no certificate pinning in v1. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
